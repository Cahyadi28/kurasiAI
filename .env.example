# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
# Jangan pernah menyimpan nilai rahasia di .env.example atau di dalam kode.

APP_ENV=local
APP_TIMEZONE=Asia/Jakarta

# Dipakai mulai Bab 12 (PDO SQLite). Path relatif terhadap folder proyek.
DB_PATH=var/kurasiai.sqlite

# Password untuk SEMUA akun contoh yang dibuat "php bin/seed.php" (minimal 8 karakter).
# Isi di .env milik Anda sendiri, jangan di berkas ini.
SEED_PASSWORD=

# Mesin AI: "fake" (tiruan, tanpa internet dan API key) atau "anthropic" (Claude API, Bab Bonus).
AI_PROVIDER=fake

# Diisi di .env milik Anda sendiri bila AI_PROVIDER=anthropic. Jangan pernah diisi di berkas ini.
AI_API_KEY=

# Model dan batas waktu (detik). Daftar model: https://platform.claude.com/docs/en/about-claude/models/overview
AI_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT=30

# Harga USD per sejuta token (masuk/keluar), untuk perkiraan biaya di halaman log pemakaian.
# Contoh: harga Claude Haiku 4.5 per September 2026. Harga bisa berubah; cek halaman harga resmi.
# Kosongkan bila tidak ingin menampilkan perkiraan biaya.
AI_PRICE_INPUT_PER_MTOK=1
AI_PRICE_OUTPUT_PER_MTOK=5
