# Salin berkas ini menjadi .env lalu sesuaikan nilainya.
# Jangan pernah menyimpan nilai rahasia di .env.example atau di dalam kode.

APP_ENV=local
APP_TIMEZONE=Asia/Jakarta

# Dipakai mulai Bab 12 (PDO SQLite). Path relatif terhadap folder proyek.
DB_PATH=var/kurasiai.sqlite

# Materi inti memakai "fake" (tanpa API key).
# Provider nyata dan API key baru dipakai di Bab Bonus.
AI_PROVIDER=fake
AI_API_KEY=
