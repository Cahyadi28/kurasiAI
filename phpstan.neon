parameters:
    # Kode inti hanya boleh memakai fitur, fungsi, dan class PHP 8.1.
    phpVersion: 80100
    level: 6
    paths:
        - bin
        - demo
        - prototipe
        - public
        - src
        - tests
    excludePaths:
        # Demo bab lama tidak diperbarui saat class berubah; kodenya tersimpan di tag git bab-XX.
        - demo/bab-02.php
        - demo/bab-03.php
        - demo/bab-04.php
        - demo/bab-05.php
        - demo/bab-06.php
        - demo/bab-07.php
        - demo/bab-08.php
        - demo/bab-09.php
        - demo/bab-10.php
        - demo/bab-11.php
        - demo/bab-12.php
        # Tampilan contoh untuk ViewTest, alasannya sama dengan folder views/.
        - tests/Fixtures
    # Folder contoh/ sengaja tidak dianalisis: berisi contoh yang memang salah
    # untuk diperlihatkan di naskah. Contoh dijalankan manual saat pemeriksaan bab.
    # Folder views/ tidak dianalisis: berkasnya dimuat View::render() dan memakai $this serta
    # variabel dari extract(), yang tidak bisa diikuti PHPStan. Tipe variabelnya ditulis di @var.
