parameters:
    # Kode inti hanya boleh memakai fitur, fungsi, dan class PHP 8.1.
    phpVersion: 80100
    level: 6
    paths:
        - demo
        - prototipe
        - src
        - tests
    excludePaths:
        # Demo bab lama tidak diperbarui saat class berubah; kodenya tersimpan di tag git bab-XX.
        - demo/bab-02.php
        - demo/bab-03.php
        - demo/bab-04.php
        - demo/bab-05.php
        - demo/bab-06.php
        - demo/bab-07.php
        - demo/bab-08.php
        - demo/bab-09.php
        - demo/bab-10.php
    # Folder contoh/ sengaja tidak dianalisis: berisi contoh yang memang salah
    # untuk diperlihatkan di naskah. Contoh dijalankan manual saat pemeriksaan bab.
    # Folder berikut ditambahkan ke "paths" begitu mulai dipakai:
    #   bin (Bab 12), public (Bab 14)
